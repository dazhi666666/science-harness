{
  "name": "agent-router",
  "version": "0.3.0",
  "description": "Local multi-agent collaboration router: a main agent delegates tasks to coding-agent CLIs through a shared task board",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "router": "node router.mjs",
    "start": "node web/server.mjs",
    "test": "node --test core/test.mjs web/test.mjs chat-agent/test.mjs lib/dsh.test.mjs",
    "sync": "node ../../scripts/sync-agent-router.mjs",
    "build:dsh-web": "node harness/build-dsh-web.mjs",
    "probe": "vitest run --config harness/vitest.config.ts"
  }
}
